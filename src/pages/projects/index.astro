---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import FeaturedProject from '../../components/FeaturedProject.astro';
import { published } from '../../lib/collections';
import { withBase } from '../../lib/url';

const [featured, ...others] = await published('projects');
---
<BaseLayout title="Projects" description="Projects and case studies.">
  <PageHead lead="Things I" title="build" intro="Projects where I rebuild something to understand it, then write up what broke along the way." />
  <section class="wrap proj-sec">
    <div class="sec-top"><h2>Projects</h2></div>
    {featured ? <FeaturedProject project={featured} /> : <p class="empty">First project write-up coming soon.</p>}
    {others.length > 0 && (
      <ul class="proj-rows">
        {others.map((p) => <li><a class="ul" href={withBase(`/projects/${p.id}/`)}>{p.data.title}</a></li>)}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .proj-sec { padding-bottom: 96px; }
  @media (max-width: 720px) { .proj-sec { padding-bottom: 56px; } }
</style>
