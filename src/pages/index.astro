---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { published } from '../lib/collections';
import { pickHome, postPath } from '../lib/content';
import { formatDate } from '../lib/format';
import { withBase } from '../lib/url';

const projects = pickHome(await published('projects'), 3);
const posts = pickHome(await published('writing'), 5);
---
<BaseLayout>
  <Hero />

  <section class="sec wrap" id="projects">
    <div class="sec-head">
      <h2>Projects</h2>
      <a class="more" href={withBase('/projects/')}>All projects <span class="arr" aria-hidden="true">→</span></a>
    </div>
    {projects.length > 0 ? (
      <ul class="rows">
        {projects.map((p) => (
          <li>
            <a class="row" href={withBase(`/projects/${p.id}/`)}>
              <span class="row-main">
                <span class="row-title">{p.data.title}</span>
                <span class="row-desc">{p.data.summary}</span>
              </span>
              <span class="row-meta">{p.data.stack.slice(0, 3).join(' · ')}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">First project write-up coming soon.</p>
    )}
  </section>

  <section class="sec wrap" id="writing">
    <div class="sec-head">
      <h2>Writing</h2>
      <a class="more" href={withBase('/writing/')}>All writing <span class="arr" aria-hidden="true">→</span></a>
    </div>
    {posts.length > 0 ? (
      <ul class="rows">
        {posts.map((post) => (
          <li>
            <a class="row" href={withBase(postPath(post))}>
              <span class="row-main">
                <span class="row-title">{post.data.title}</span>
                <span class="row-desc">{post.data.description}</span>
              </span>
              <time class="row-meta" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">First post coming soon.</p>
    )}
  </section>
</BaseLayout>
