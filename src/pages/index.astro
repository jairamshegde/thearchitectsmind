---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeaturedSeries from '../components/FeaturedSeries.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import WritingBand, { type BandNote, type BandPost } from '../components/WritingBand.astro';
import { published } from '../lib/collections';
import { pickHome, postPath, seriesParts } from '../lib/content';
import { withBase } from '../lib/url';

const writing = await published('writing');
const minutesOf = async (post: (typeof writing)[number]) => (await render(post)).remarkPluginFrontmatter.minutesRead as number;

// Every series with at least one published part, the most recently updated first.
const series = (
  await Promise.all(
    (await getCollection('series')).map(async (s) => {
      const parts = seriesParts(writing, s.id);
      return {
        name: s.data.title.charAt(0).toUpperCase() + s.data.title.slice(1),
        description: s.data.description,
        href: withBase(`/writing/${s.id}/`),
        latest: Math.max(0, ...parts.map((p) => p.data.date.getTime())),
        parts: await Promise.all(parts.map(async (p) => ({ href: withBase(postPath(p)), title: p.data.title, minutes: await minutesOf(p) }))),
      };
    }),
  )
)
  .filter((s) => s.parts.length > 0)
  .sort((a, b) => b.latest - a.latest);

const posts: BandPost[] = await Promise.all(
  writing.slice(0, 5).map(async (post) => ({
    href: withBase(postPath(post)),
    date: post.data.date,
    title: post.data.title,
    minutes: await minutesOf(post),
  })),
);
const notes: BandNote[] = (await published('notes')).slice(0, 4).map((n) => ({
  href: withBase(`/notes/${n.id}/`),
  topic: n.data.tags[0],
  date: n.data.date,
  title: n.data.title,
}));
const [project] = pickHome(await published('projects'), 1);
---
<BaseLayout variant="home">
  <Hero />

  {series.length > 0 && (
    <section class="wrap home-sec" id="series">
      <div class="sec-top">
        <h2>Featured series</h2>
        <a class="ul" href={withBase('/writing/')}>All writing</a>
      </div>
      {series.map((s) => <FeaturedSeries name={s.name} description={s.description} href={s.href} parts={s.parts} />)}
    </section>
  )}

  <WritingBand posts={posts} notes={notes} writingHref={withBase('/writing/')} notesHref={withBase('/notes/')} />

  <section class="wrap home-sec" id="projects">
    <div class="sec-top">
      <h2>Featured project</h2>
      <a class="ul" href={withBase('/projects/')}>All projects</a>
    </div>
    {project ? <FeaturedProject project={project} /> : <p class="empty">First project write-up coming soon.</p>}
  </section>
</BaseLayout>


<style>
  /* every homepage section uses the same rhythm as the writing band */
  .home-sec { padding-top: 80px; padding-bottom: 88px; }
  #series { padding-top: 24px; }
  @media (max-width: 720px) {
    .home-sec { padding-top: 56px; padding-bottom: 64px; }
    #series { padding-top: 16px; }
  }
</style>
