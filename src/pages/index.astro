---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import WritingBand, { type BandNote, type BandPost } from '../components/WritingBand.astro';
import { published } from '../lib/collections';
import { pickHome, postPath } from '../lib/content';
import { withBase } from '../lib/url';

const [featured, ...others] = pickHome(await published('projects'), 3);
const posts: BandPost[] = await Promise.all(
  pickHome(await published('writing'), 5).map(async (post) => ({
    href: withBase(postPath(post)),
    date: post.data.date,
    title: post.data.title,
    minutes: (await render(post)).remarkPluginFrontmatter.minutesRead as number,
  })),
);
const notes: BandNote[] = (await published('notes')).slice(0, 4).map((n) => ({
  href: withBase(`/notes/${n.id}/`),
  topic: n.data.tags[0],
  date: n.data.date,
  title: n.data.title,
}));
---
<BaseLayout variant="home">
  <Hero />

  <section class="wrap home-sec" id="projects">
    <div class="sec-top">
      <h2>Projects</h2>
      <a class="ul" href={withBase('/projects/')}>All projects</a>
    </div>
    {featured ? <FeaturedProject project={featured} /> : <p class="empty">First project write-up coming soon.</p>}
    {others.length > 0 && (
      <ul class="proj-rows">
        {others.map((p) => <li><a class="ul" href={withBase(`/projects/${p.id}/`)}>{p.data.title}</a></li>)}
      </ul>
    )}
  </section>

  <WritingBand posts={posts} notes={notes} blogHref={withBase('/writing/')} notesHref={withBase('/notes/')} />
</BaseLayout>


<style>
  .home-sec { padding-bottom: 140px; }
  .proj-rows { list-style: none; margin: 48px 0 0; padding: 0; border-top: 1px solid var(--line); }
  .proj-rows li { padding: 20px 0; border-bottom: 1px solid var(--line); font-size: 22px; font-weight: 500; letter-spacing: -.012em; }
  @media (max-width: 720px) { .home-sec { padding-bottom: 72px; } }
</style>
