---
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import NoteRow from '../../components/NoteRow.astro';
import Pagination from '../../components/Pagination.astro';
import { published } from '../../lib/collections';
import { groupByMonth } from '../../lib/content';

// /notes/ is page 1, then /notes/2/, /notes/3/ ...
export const getStaticPaths = (async ({ paginate }) => paginate(await published('notes'), { pageSize: 10 })) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<'notes'>>;
}
const { page } = Astro.props;
const groups = groupByMonth(page.data);
---
<BaseLayout title={page.currentPage === 1 ? 'Notes' : `Notes, page ${page.currentPage}`} description="Short notes and quick tutorials on what I'm learning.">
  <PageHead lead="Short" title="notes" intro="Short, unpolished notes. Sketches, half-formed ideas and things I’m still figuring out." />
  <div class="wrap notes-body">
    {groups.length === 0 && <p class="empty">First note coming soon.</p>}
    {groups.map((g) => (
      <section class="month-group">
        <h2>{g.label}</h2>
        <ol class="note-list">{g.items.map((note) => <NoteRow note={note} />)}</ol>
      </section>
    ))}
    <Pagination current={page.currentPage} last={page.lastPage} base="/notes/" label="Notes pages" />
  </div>
</BaseLayout>

<style>
  .notes-body { padding-bottom: 56px; }
  .month-group { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; padding-top: 20px; border-top: 2px solid var(--ink); margin-bottom: 40px; }
  .month-group h2 { grid-column: 1 / span 3; font-size: 26px; line-height: 1.2; letter-spacing: -.02em; }
  .note-list { grid-column: 4 / span 9; list-style: none; margin: 0; padding: 0; }
  @media (max-width: 900px) {
    .month-group h2, .note-list { grid-column: 1 / -1; }
    .month-group h2 { margin-bottom: 8px; }
  }
  @media (max-width: 720px) { .notes-body { padding-bottom: 56px; } }
</style>
