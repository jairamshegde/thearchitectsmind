---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteRow from '../../components/NoteRow.astro';
import { published } from '../../lib/collections';
import { groupByYear } from '../../lib/content';

const groups = groupByYear(await published('notes'));
---
<BaseLayout title="Notes" description="Short notes and quick tutorials on what I'm learning.">
  <header class="page-head wrap">
    <h1>Notes</h1>
    <p>Short notes and quick tutorials from what I'm learning and building.</p>
  </header>
  <div class="wrap page-body">
    {groups.length === 0 && <p class="empty">First note coming soon.</p>}
    {groups.map((g) => (
      <section class="year-group">
        <h2>{g.year}</h2>
        <ol class="note-list">{g.items.map((note) => <NoteRow note={note} />)}</ol>
      </section>
    ))}
  </div>
</BaseLayout>
