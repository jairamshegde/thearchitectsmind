---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { withBase } from '../lib/url';
---
<BaseLayout title="Not found">
  <PageHead lead="404." title="This page took a different path" intro="Maybe it was renamed, or it never existed.">
    <div class="nf-links">
      <a class="pill pill-ink" href={withBase('/')}>Go home</a>
      <a class="ul-on" href={withBase('/writing/')}>Read the blog</a>
    </div>
  </PageHead>
</BaseLayout>

<style>
  .nf-links { margin-top: 32px; padding-bottom: 72px; display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; }
</style>
