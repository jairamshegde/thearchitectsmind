---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import PostMeta from '../../components/PostMeta.astro';
import { published } from '../../lib/collections';
import { neighbours } from '../../lib/content';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await published('writing');
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, ...neighbours(posts, i) } }));
}

interface Props {
  post: CollectionEntry<'writing'>;
  newer?: CollectionEntry<'writing'>;
  older?: CollectionEntry<'writing'>;
}
const { post, newer, older } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const { title, subheading, description, date, tags, cover } = post.data;
---
<ArticleLayout title={title} description={description} headings={headings} back={{ href: withBase('/writing/'), label: 'All writing' }}>
  <Fragment slot="header">
    {cover && <Image class="article-cover post-cover" src={cover} alt="" widths={[860, 1500]} sizes="(max-width: 900px) 100vw, 860px" loading="eager" />}
    <h1 class="article-title">{title}</h1>
    {subheading && <p class="article-sub">{subheading}</p>}
    <div class="article-info">
      <ul class="article-tags">{tags.map((tag) => <li>{tag}</li>)}</ul>
      <PostMeta date={date} minutes={remarkPluginFrontmatter.minutesRead} />
    </div>
  </Fragment>

  <Content />

  <nav slot="after" class="prev-next" aria-label="More writing">
    {older && <a class="pn pn-prev" href={withBase(`/writing/${older.id}/`)}><span>← Previous</span>{older.data.title}</a>}
    {newer && <a class="pn pn-next" href={withBase(`/writing/${newer.id}/`)}><span>Next →</span>{newer.data.title}</a>}
  </nav>
</ArticleLayout>
