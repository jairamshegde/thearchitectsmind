---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { published } from '../../lib/collections';

const posts = await published('writing');
---
<BaseLayout title="Writing" description="Long-form writing on architecture and engineering.">
  <header class="page-head wrap">
    <h1>Writing</h1>
    <p>Long-form pieces on how systems are shaped, and why.</p>
  </header>
  <div class="wrap page-body">
    {posts.length > 0 ? <div class="writing-grid">{posts.map((post) => <PostCard post={post} />)}</div> : <p class="empty">First post coming soon.</p>}
  </div>
</BaseLayout>
