---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { published } from '../../lib/collections';
import { postPath, topTags } from '../../lib/content';
import { formatDate } from '../../lib/format';
import { withBase } from '../../lib/url';

const posts = await Promise.all(
  (await published('writing')).map(async (post) => ({ post, minutes: (await render(post)).remarkPluginFrontmatter.minutesRead as number })),
);
const [latest, ...rest] = posts;
const tags = topTags(rest.map((r) => r.post), 10);
const day = (d: Date) => d.toISOString().slice(0, 10);
---
<BaseLayout title="Blog" description="Long-form writing on building software and AI systems.">
  <PageHead title="Blog" intro="Essays from building things. Most take one idea and build it into working code, then write down what broke." />

  {latest ? (
    <section class="wrap idx-sec" aria-label="Latest post">
      <a class="latest-card grid" href={withBase(postPath(latest.post))}>
        <div class="latest-media">
          {latest.post.data.cover && <Image src={latest.post.data.cover} alt="" widths={[800, 1200, 1600]} sizes="(max-width: 1100px) 100vw, 760px" loading="eager" />}
        </div>
        <div class="latest-body">
          <span class="card-meta">Latest · <time datetime={day(latest.post.data.date)}>{formatDate(latest.post.data.date)}</time> · {latest.minutes} min</span>
          <span class="latest-title">{latest.post.data.title}</span>
          <span class="latest-desc">{latest.post.data.description}</span>
          <span class="pill pill-outline">Read the post</span>
        </div>
      </a>
    </section>
  ) : (
    <p class="wrap empty">First post coming soon.</p>
  )}

  {rest.length > 0 && (
    <section class="wrap idx-sec" aria-labelledby="all-h">
      <div class="sec-top"><h2 id="all-h">All posts</h2></div>
        {tags.length > 0 && (
          <div class="tag-filter" role="group" aria-label="Filter posts by tag">
            <button type="button" aria-pressed="true" data-tag="">All</button>
            {tags.map((tag) => <button type="button" aria-pressed="false" data-tag={tag}>{tag}</button>)}
          </div>
        )}
      <ul class="wgrid">
        {rest.map(({ post, minutes }) => (
          <li>
            <a class="wcard" href={withBase(postPath(post))} data-tags={JSON.stringify(post.data.tags)}>
              <span class="card-meta"><time datetime={day(post.data.date)}>{formatDate(post.data.date)}</time> · {minutes} min</span>
              <span class="wtitle">{post.data.title}</span>
              <span class="wdesc">{post.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.tag-filter button')];
  const cards = [...document.querySelectorAll<HTMLElement>('.wcard')];
  for (const button of buttons) {
    button.addEventListener('click', () => {
      const tag = button.dataset.tag!;
      for (const b of buttons) b.setAttribute('aria-pressed', String(b === button));
      for (const card of cards) card.parentElement!.hidden = tag !== '' && !JSON.parse(card.dataset.tags!).includes(tag);
    });
  }
</script>

<style>
  .idx-sec { padding-bottom: 56px; }
  .card-meta { font-size: 13px; font-weight: 500; color: var(--muted); }
  .latest-card { margin-top: 40px; align-items: center; }
  .latest-media { grid-column: 1 / span 7; aspect-ratio: 16 / 10; border-radius: 16px; overflow: hidden; background: var(--soft); }
  .latest-media :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease); }
  .latest-card:hover .latest-media :global(img) { transform: scale(1.025); }
  .latest-body { grid-column: 9 / span 4; display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .latest-title { font-family: var(--display); font-size: clamp(30px, 3vw, 40px); font-weight: 600; line-height: 1.05; letter-spacing: -.03em; transition: color .35s var(--ease); }
  .latest-card:hover .latest-title { color: var(--accent-ink); }
  .latest-desc { font-size: 18px; line-height: 1.5; color: var(--muted); }
  .latest-body .pill { margin-top: 6px; font-size: 15px; }
  .latest-card:hover .pill { background: var(--ink); color: var(--bg); }

  .tag-filter { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
  .tag-filter button { min-height: 32px; padding: 0 12px; border: 1px solid var(--line); border-radius: 999px; background: none; font-size: 13px; color: var(--muted); cursor: pointer; transition: border-color .3s var(--ease), color .3s var(--ease); }
  .tag-filter button:hover { border-color: var(--ink); color: var(--ink); }
  .tag-filter button[aria-pressed='true'] { border-color: var(--ink); background: var(--ink); color: var(--bg); }

  .wgrid { list-style: none; margin: 24px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .wgrid li[hidden] { display: none; }
  .wcard { display: flex; flex-direction: column; gap: 14px; height: 100%; min-height: 220px; padding: 24px; border: 1px solid var(--line); border-radius: 14px; transition: background-color .35s var(--ease), border-color .35s var(--ease); }
  .wcard:hover { background: var(--soft); border-color: var(--soft); }
  .wtitle { font-family: var(--display); font-size: 22px; font-weight: 600; line-height: 1.2; letter-spacing: -.015em; }
  .wdesc { margin-top: auto; font-size: 15px; line-height: 1.5; color: var(--muted); }

  @media (max-width: 1100px) {
    .latest-media, .latest-body { grid-column: 1 / -1; }
    .latest-body { margin-top: 28px; }
    .wgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 720px) {
    .idx-sec { padding-bottom: 44px; }
    .wgrid { grid-template-columns: minmax(0, 1fr); }
    .wcard { min-height: 0; }
  }
</style>
