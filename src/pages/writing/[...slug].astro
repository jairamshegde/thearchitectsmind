---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import PixelField from '../../components/PixelField.astro';
import { POST_FIELD } from '../../lib/pixel-field';
import { formatDate, splitTitle } from '../../lib/format';
import { published } from '../../lib/collections';
import { neighbours, postPath, postSlug, seriesParts } from '../../lib/content';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await published('writing');
  const allSeries = new Map((await getCollection('series')).map((s) => [s.id, s]));
  return posts.map((post, i) => {
    const name = post.data.series;
    if (!name) {
      if (allSeries.has(post.id)) throw new Error(`Post "${post.id}" has the same slug as a series; rename one of them`);
      const { newer, older } = neighbours(posts, i);
      return { params: { slug: postSlug(post) }, props: { post, prev: older, next: newer } };
    }
    const series = allSeries.get(name);
    if (!series) throw new Error(`Post "${post.id}" names series "${name}", which does not exist`);
    const parts = seriesParts(posts, name);
    const at = parts.indexOf(post);
    return {
      params: { slug: postSlug(post) },
      props: { post, prev: parts[at - 1], next: parts[at + 1], series: { entry: series, at: at + 1, of: parts.length } },
    };
  });
}

interface Props {
  post: CollectionEntry<'writing'>;
  prev?: CollectionEntry<'writing'>;
  next?: CollectionEntry<'writing'>;
  series?: { entry: CollectionEntry<'series'>; at: number; of: number };
}
const { post, prev, next, series } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const { title, description, date, tags, cover } = post.data;
const titleLines = splitTitle(title);
const seriesName = series ? series.entry.data.title.charAt(0).toUpperCase() + series.entry.data.title.slice(1) : '';
---
<ArticleLayout title={title} description={description} headings={headings} headClass="post-head">
  <Fragment slot="header">
    {series && (
      <p class="series-line fade-up" style="--d:.3s">{seriesName} series, part {series.at} of {series.of} · <a class="ul-on" href={withBase(`/writing/${series.entry.id}/`)}>See all parts</a></p>
    )}
    <div class="post-head-grid">
      <div>
        <h1 class="post-title">
          {titleLines.filter(Boolean).map((line) => <span class="mask"><span>{line}</span></span>)}
        </h1>
        <p class="dek fade-up" style="--d:.5s">{description}</p>
      </div>
      <PixelField config={POST_FIELD} class="post-field" />
    </div>
    <dl class="post-meta fade-up" style="--d:.6s">
      <div><dt>Published</dt><dd><time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time></dd></div>
      <div><dt>Reading time</dt><dd>{remarkPluginFrontmatter.minutesRead} min</dd></div>
      {series && <div><dt>Part</dt><dd>{series.at} of {series.of}</dd></div>}
      <div><dt>Tags</dt><dd><ul class="tags">{tags.map((tag) => <li class="tag">{tag}</li>)}</ul></dd></div>
    </dl>
  </Fragment>

  {cover && (
    <figure class="post-cover" slot="cover">
      <Image src={cover} alt="" widths={[860, 1360, 2000]} sizes="(max-width: 1440px) calc(100vw - 80px), 1280px" loading="eager" />
    </figure>
  )}

  <Content />

  <Fragment slot="after">
    {series && (
      <p class="series-mark">
        Part {series.at} of {series.of} in <a href={withBase(`/writing/${series.entry.id}/`)}>{series.entry.data.title}</a>
      </p>
    )}
    <nav class="prev-next" aria-label={series ? 'More in this series' : 'More writing'}>
      {prev && <a class="pn pn-prev" href={withBase(postPath(prev))}><span>← Previous</span>{prev.data.title}</a>}
      {next && <a class="pn pn-next" href={withBase(postPath(next))}><span>Next →</span>{next.data.title}</a>}
    </nav>
  </Fragment>
</ArticleLayout>
