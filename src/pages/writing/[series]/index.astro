---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHead from '../../../components/PageHead.astro';
import { published } from '../../../lib/collections';
import { postPath, seriesParts } from '../../../lib/content';
import { withBase } from '../../../lib/url';

export async function getStaticPaths() {
  const posts = await published('writing');
  return (await getCollection('series')).map((series) => ({
    params: { series: series.id },
    props: { series, parts: seriesParts(posts, series.id) },
  }));
}

interface Props {
  series: CollectionEntry<'series'>;
  parts: CollectionEntry<'writing'>[];
}
const { series, parts } = Astro.props;
const { title, description } = series.data;
const name = title.charAt(0).toUpperCase() + title.slice(1);
const rows = await Promise.all(parts.map(async (post) => ({ post, minutes: (await render(post)).remarkPluginFrontmatter.minutesRead as number })));
---
<BaseLayout title={name} description={description}>
  <PageHead lead="The" title={`${name} series`} intro={description} />
  <section class="wrap series-sec">
    <div class="sec-top"><h2>All parts</h2><a class="ul" href={withBase('/writing/')}>All posts</a></div>
    {rows.length === 0 ? <p class="empty">First part coming soon.</p> : (
      <ol class="rows">
        {rows.map(({ post, minutes }, i) => (
          <li>
            <a class="row" href={withBase(postPath(post))}>
              <span class="row-label">Part {i + 1}</span>
              <span class="row-title">{post.data.title}<span class="row-dek">{post.data.description}</span></span>
              <span class="row-time">{minutes} min</span>
            </a>
          </li>
        ))}
      </ol>
    )}
  </section>
</BaseLayout>

<style>
  .series-sec { padding-bottom: 80px; }
  .rows { list-style: none; margin: 32px 0 0; padding: 0; border-top: 1px solid var(--line); }
  .row { position: relative; display: grid; grid-template-columns: 112px minmax(0, 1fr) 80px; gap: 20px; align-items: baseline; padding: 24px 0; border-bottom: 1px solid var(--line); }
  .row::before { content: ''; position: absolute; inset: 0 -20px; border-radius: 10px; background: var(--soft); opacity: 0; transform: scaleY(.85); transition: opacity .35s var(--ease), transform .45s var(--ease); }
  .row:hover::before { opacity: 1; transform: none; }
  .row > * { position: relative; }
  .row-label, .row-time { font-size: 13px; font-weight: 500; color: var(--muted); }
  .row-time { text-align: right; }
  .row-title { font-size: 22px; font-weight: 500; line-height: 1.3; letter-spacing: -.012em; transition: transform .45s var(--ease); }
  .row:hover .row-title { transform: translateX(6px); }
  .row-dek { display: block; margin-top: 6px; font-size: 16px; font-weight: 400; letter-spacing: 0; color: var(--muted); }
  @media (max-width: 720px) {
    .series-sec { padding-bottom: 56px; }
    .row { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'label time' 'title title'; gap: 8px 16px; }
    .row::before { inset: 0 -10px; }
    .row-label { grid-area: label; } .row-time { grid-area: time; } .row-title { grid-area: title; font-size: 20px; }
  }
</style>
