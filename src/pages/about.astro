---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { renderMarkdown } from '../lib/markdown-text';
import { withBase } from '../lib/url';

const about = await getEntry('pages', 'about');
if (!about) throw new Error('Missing src/content/pages/about.md');
const settings = await getEntry('settings', 'site');
if (!settings) throw new Error('Missing src/content/settings/site.json');
const { Content } = await render(about);
const { title, intro, lead, leadMore, welcomeImage, welcomeNote, summary, steps, signoff, quirks, now, contact } = about.data;
const github = settings.data.socials.find((s) => s.label === 'GitHub');

// Quirks are short markdown; site-root links ("/writing/...") get the base path like the rest of the site.
const quirkHtml = (q: string) => renderMarkdown(q).replaceAll('href="/', `href="${withBase('/')}`);

const sentence = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
---
<BaseLayout title="About" description={intro}>
  <div class="wrap grid about">
    <aside class="about-side">
      {welcomeImage && (
        <figure class="about-pico">
          <Image src={welcomeImage} alt="Pico the penguin waving hello from behind a laptop, next to a mug and a stack of books" widths={[280, 560]} sizes="140px" loading="eager" />
          {welcomeNote && <figcaption>{welcomeNote}</figcaption>}
        </figure>
      )}
      <h1>{title}</h1>
      {lead && <p class="about-lead">{lead}{leadMore && <> <span>{leadMore}</span></>}</p>}
      {summary.length > 0 && (
        <dl class="about-summary">
          {summary.map((s) => <div><dt>{sentence(s.label)}</dt><dd>{s.value}</dd></div>)}
        </dl>
      )}
      <div class="about-actions">
        <a class="pill pill-ink" href="#contact">Get in touch</a>
        {github && <a class="ul-on" href={github.url} rel="me noopener">GitHub</a>}
      </div>
    </aside>

    <div class="about-main">
      <section id="working-on">
        <div class="sec-top"><h2>What I’m working on now</h2></div>
        <div class="about-copy"><Content /></div>
      </section>

      {steps.length > 0 && (
        <section id="approach">
          <div class="sec-top"><h2>How I take a problem apart</h2></div>
          <ol class="about-steps about-copy">{steps.map((step) => <li><b>{step.title}</b> {step.text}</li>)}</ol>
        </section>
      )}

      {signoff && (
        <section>
          <div class="sec-top"><h2>What I won’t sign off on</h2></div>
          <div class="about-copy"><p>{signoff}</p></div>
        </section>
      )}

      {quirks.length > 0 && (
        <section>
          <div class="sec-top"><h2>Known quirks</h2></div>
          <ul class="about-quirks about-copy">{quirks.map((q) => <li set:html={quirkHtml(q)} />)}</ul>
        </section>
      )}

      {now.length > 0 && (
        <section>
          <div class="sec-top"><h2>Right now</h2></div>
          <dl class="about-now">{now.map((n) => <div><dt>{sentence(n.label)}</dt><dd>{n.value}</dd></div>)}</dl>
        </section>
      )}

      {(contact || github) && (
        <section>
          <div class="sec-top"><h2>Get in touch</h2></div>
          <div class="about-copy"><p>{contact}{github && <> <a href={github.url} rel="me noopener">GitHub</a>.</>}</p></div>
        </section>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .about { padding-top: 64px; padding-bottom: 96px; align-items: start; }
  .about-side { grid-column: 1 / span 4; position: sticky; top: 110px; }
  .about-pico { margin: 0; }
  .about-pico :global(img) { display: block; width: 140px; height: auto; }
  .about-pico figcaption { margin-top: 10px; max-width: 30ch; font-size: 15px; font-style: italic; font-weight: 500; line-height: 1.4; color: var(--accent-ink); }
  h1 { margin-top: 24px; font-size: clamp(40px, 4vw, 56px); line-height: 1; letter-spacing: -.035em; }
  .about-lead { margin: 20px 0 0; font-size: 18px; line-height: 1.5; color: var(--ink); }
  .about-lead span { color: var(--muted); }
  .about-summary { margin: 28px 0 0; padding-top: 16px; border-top: 2px solid var(--ink); display: grid; gap: 12px; }
  .about-summary dt { font-size: 13px; color: var(--muted); }
  .about-summary dd { margin: 2px 0 0; font-size: 15px; font-weight: 500; }
  .about-actions { margin-top: 28px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; }

  .about-main { grid-column: 6 / span 7; }
  .about-main section + section { margin-top: 64px; }
  .about-main h2 { font-size: clamp(28px, 3vw, 40px); }
  .about-copy { margin-top: 28px; }
  .about-copy, .about-copy :global(p), .about-copy :global(li) { font-size: 17px; line-height: 1.6; color: var(--body); }
  .about-copy :global(p) { margin: 0 0 1em; }
  .about-copy > :global(:last-child) { margin-bottom: 0; }
  .about-copy :global(a) { color: var(--ink); text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 3px; }
  .about-steps { padding-left: 1.3em; margin-bottom: 0; }
  .about-steps li + li { margin-top: .8em; }
  .about-steps li::marker { color: var(--accent); font-weight: 600; }
  .about-steps b { color: var(--ink); font-weight: 600; }
  .about-quirks { padding-left: 1.2em; margin-bottom: 0; }
  .about-quirks li + li { margin-top: .4em; }
  .about-quirks li::marker { color: var(--accent); }
  .about-now { margin: 28px 0 0; border-top: 1px solid var(--line); }
  .about-now div { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); font-size: 17px; }
  .about-now dt { color: var(--muted); }
  .about-now dd { margin: 0; }

  @media (max-width: 1100px) {
    .about-side, .about-main { grid-column: 1 / -1; }
    .about-side { position: static; margin-bottom: 64px; }
  }
  @media (max-width: 720px) {
    .about { padding-top: 40px; padding-bottom: 56px; }
    .about-main section + section { margin-top: 48px; }
    .about-now div { grid-template-columns: 110px minmax(0, 1fr); }
  }
</style>
