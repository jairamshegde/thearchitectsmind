---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StackGraph from '../components/StackGraph.astro';

const about = await getEntry('pages', 'about');
if (!about) throw new Error('Missing src/content/pages/about.md');
const settings = await getEntry('settings', 'site');
if (!settings) throw new Error('Missing src/content/settings/site.json');
const { Content } = await render(about);
const { title, intro, tagline, photo, welcomeImage, welcomeNote, summary, writeAbout, outside, saltLabel, saltLine, contact, disclaimer } = about.data;
const github = settings.data.socials.find((s) => s.label === 'GitHub');
const linkedin = settings.data.socials.find((s) => s.label === 'LinkedIn');
const email = settings.data.email ?? '[YOUR EMAIL]';
// Icon paths (24x24). Mail is drawn; the LinkedIn and GitHub marks are the brands' own shapes.
const icons = {
  Email: '<rect x="3" y="5" width="18" height="14" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M4 7l8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
  LinkedIn: '<path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z"/>',
  GitHub: '<path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z"/>',
};
const socialLinks = [
  { label: 'Email', href: `mailto:${email}` },
  linkedin && { label: 'LinkedIn', href: linkedin.url },
  github && { label: 'GitHub', href: github.url },
].filter(Boolean) as { label: keyof typeof icons; href: string }[];

const sentence = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
---
<BaseLayout title="About" description={intro}>
  <div class="wrap grid about">
    <aside class="about-side">
      {photo && (
        <figure class="about-photo" data-photo>
          <Image src={photo} alt={`Portrait of ${title}`} widths={[220, 440]} sizes="220px" loading="eager" />
          <canvas aria-hidden="true"></canvas>
        </figure>
      )}
      <h1>{title}<span class="accent-dot">.</span></h1>
      {tagline && (
        <p class="about-tagline">
          <span>{tagline.split('|').map((part) => <span>{part.trim()}</span>)}</span>
        </p>
      )}
      {summary.length > 0 && (
        <dl class="about-summary">
          {summary.map((s) => <div><dt>{sentence(s.label)}</dt><dd>{s.value}</dd></div>)}
        </dl>
      )}
      <div class="about-actions">
        <a class="pill pill-ink" href="#get-in-touch">Get in touch</a>
        {github && <a class="ul-on" href={github.url} rel="me noopener">GitHub</a>}
      </div>
      {welcomeImage && (
        <div class="about-pico" data-pico>
          <button type="button" class="pico-btn" aria-expanded="false" aria-controls="pico" data-pico-btn>Meet Pico</button>
          <figure class="pico-peek" id="pico">
            <div>
              <div class="pico-window">
                <Image src={welcomeImage} alt="Pico the penguin waving hello from behind a laptop, next to a mug and a stack of books" widths={[240, 480]} sizes="120px" />
              </div>
              {welcomeNote && (
                <figcaption class="pico-note">
                  <span class="visually-hidden">{welcomeNote}</span>
                  <span aria-hidden="true">{[...welcomeNote].map((c, i) => <span style={`--i:${i}`}>{c}</span>)}</span>
                </figcaption>
              )}
            </div>
          </figure>
        </div>
      )}
    </aside>

    <div class="about-main">
      <section class="about-body about-copy"><Content /></section>

      <section id="stack">
        <h2>What I build with</h2>
        <StackGraph />
      </section>

      {writeAbout && (
        <section>
          <h2>What I write about</h2>
          <div class="about-copy"><p>{writeAbout}</p></div>
        </section>
      )}

      {outside && saltLabel && (
        <section>
          <h2>Outside work</h2>
          <div class="about-copy">
            <p class="salt-intro">{outside} <button type="button" class="salt-link" aria-expanded="false" aria-controls="salt" data-salt-link>{saltLabel}</button>.</p>
            <div class="salt" id="salt" data-salt>
              <div>
                <button type="button" class="salt-num" aria-label="31,459 salt crystals. Click to look again." data-salt-num><span>3</span><span class="p">.</span><span>1</span><span class="c">,</span><span>4</span><span>5</span><span>9</span></button>
                <p class="salt-cap" data-salt-cap>salt crystals per meal. <button type="button" data-salt-again>Look at the digits again.</button></p>
                {saltLine && <p class="salt-end" data-salt-end>{saltLine}</p>}
              </div>
            </div>
          </div>
        </section>
      )}

      {(contact || socialLinks.length > 0) && (
        <section id="get-in-touch">
          <h2>Get in touch</h2>
          {contact && <div class="about-copy"><p>{contact}</p></div>}
          <ul class="socials">
            {socialLinks.map((s) => (
              <li>
                <a href={s.href} aria-label={s.label} title={s.label} rel={s.href.startsWith('http') ? 'me noopener' : undefined}>
                  <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" set:html={icons[s.label]} />
                </a>
              </li>
            ))}
          </ul>
          {disclaimer && <p class="about-fine">{disclaimer}</p>}
        </section>
      )}
    </div>
  </div>
</BaseLayout>

<script>
  // Photo: drawn pixelated on a canvas; hover (or a tap) steps the blocks down to the sharp image.
  const photo = document.querySelector<HTMLElement>('[data-photo]');
  const img = photo?.querySelector('img');
  const canvas = photo?.querySelector('canvas');
  if (photo && img && canvas) {
    const ctx = canvas.getContext('2d')!;
    const small = document.createElement('canvas');
    const sctx = small.getContext('2d')!;
    const blocks = [22, 14, 9, 5, 3, 0]; // CSS px per block; 0 = the sharp image
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let at = 0, target = 0, timer = 0;
    const draw = () => {
      const block = blocks[at];
      photo.classList.toggle('sharp', block === 0);
      if (block === 0) return;
      const r = photo.getBoundingClientRect(), dpr = devicePixelRatio || 1;
      canvas.width = Math.round(r.width * dpr); canvas.height = Math.round(r.height * dpr);
      small.width = Math.max(1, Math.ceil(r.width / block)); small.height = Math.max(1, Math.ceil(r.height / block));
      // object-fit: cover crop of the source
      const s = Math.max(small.width / img.naturalWidth, small.height / img.naturalHeight);
      const w = small.width / s, h = small.height / s;
      sctx.drawImage(img, (img.naturalWidth - w) / 2, (img.naturalHeight - h) / 2, w, h, 0, 0, small.width, small.height);
      ctx.imageSmoothingEnabled = false;
      ctx.drawImage(small, 0, 0, canvas.width, canvas.height);
    };
    const go = (to: number) => {
      target = to;
      clearInterval(timer);
      if (reduce) { at = to; draw(); return; }
      timer = window.setInterval(() => {
        if (at === target) return clearInterval(timer);
        at += Math.sign(target - at);
        draw();
      }, 70);
    };
    const start = () => {
      draw();
      photo.classList.add('ready');
      const last = blocks.length - 1;
      photo.addEventListener('pointerenter', (e) => { if (e.pointerType !== 'touch') go(last); });
      photo.addEventListener('pointerleave', (e) => { if (e.pointerType !== 'touch') go(0); });
      photo.addEventListener('click', () => { if (matchMedia('(hover: none)').matches) go(target ? 0 : last); });
      new ResizeObserver(draw).observe(photo);
    };
    if (img.complete && img.naturalWidth) start(); else img.addEventListener('load', start, { once: true });
  }

  // Pico: hidden until "Meet Pico"; he peeks up and the note writes itself out.
  const picoBtn = document.querySelector<HTMLButtonElement>('[data-pico-btn]');
  picoBtn?.addEventListener('click', () => {
    const open = picoBtn.closest('[data-pico]')!.classList.toggle('open');
    picoBtn.setAttribute('aria-expanded', String(open));
  });

  // Salt: the link opens the count (it counts up once), then each click on the number
  // flips it between 31,459 and 3.1459. The pi line shows only in the pi state.
  const link = document.querySelector<HTMLButtonElement>('[data-salt-link]');
  const box = document.querySelector<HTMLElement>('[data-salt]');
  const num = document.querySelector<HTMLButtonElement>('[data-salt-num]');
  if (link && box && num) {
    const cap = document.querySelector<HTMLElement>('[data-salt-cap]')!;
    const end = document.querySelector<HTMLElement>('[data-salt-end]');
    const digits = [...num.querySelectorAll('span:not(.p):not(.c)')];
    const target = '31459';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    link.addEventListener('click', () => {
      if (box.classList.contains('open')) return;
      box.classList.add('open');
      link.setAttribute('aria-expanded', 'true');
      if (reduce) return;
      const t0 = performance.now(), dur = 1100;
      const step = (t: number) => {
        const k = Math.min(1, (t - t0) / dur);
        const s = String(Math.round(31459 * (1 - Math.pow(1 - k, 3)))).padStart(5, '0');
        digits.forEach((d, i) => { d.textContent = k < 1 ? s[i] : target[i]; });
        if (k < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
    const flip = () => {
      const pi = num.classList.toggle('pi');
      num.setAttribute('aria-label', pi ? '3.1459, almost pi. Click to go back.' : '31,459 salt crystals. Click to look again.');
      cap.style.visibility = pi ? 'hidden' : '';
      end?.classList.toggle('show', pi);
    };
    num.addEventListener('click', flip);
    document.querySelector('[data-salt-again]')?.addEventListener('click', flip);
  }
</script>

<style>
  .about { padding-top: 64px; padding-bottom: 96px; align-items: start; }
  .about-side { grid-column: 1 / span 4; position: sticky; top: 110px; }
  .about-photo { position: relative; margin: 0; width: 220px; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 4px; background: var(--soft); cursor: crosshair; }
  .about-photo :global(img), .about-photo canvas { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .about-photo :global(img) { display: block; }
  /* without the script the photo stays blurred; with it, the canvas covers it until the last step */
  .about-photo:not(:global(.ready)) :global(img) { filter: blur(10px); transform: scale(1.06); }
  .about-photo:not(:global(.ready)) canvas, .about-photo:global(.sharp) canvas { visibility: hidden; }
  h1 { margin-top: 24px; font-size: clamp(40px, 4vw, 56px); line-height: 1; letter-spacing: -.035em; }
  .accent-dot { color: var(--accent); }
  /* each part carries its "|" in front; a part that starts a line pushes its "|" into the clipped margin */
  .about-tagline { margin: 18px 0 0; overflow: hidden; font-size: 16px; font-weight: 500; line-height: 1.4; color: var(--ink); }
  .about-tagline > span { display: flex; flex-wrap: wrap; row-gap: 4px; margin-left: -22px; }
  .about-tagline > span > span::before { content: '|'; display: inline-block; width: 22px; text-align: center; color: var(--accent); }
  .about-summary { margin: 28px 0 0; padding-top: 16px; border-top: 2px solid var(--ink); display: grid; gap: 12px; }
  .about-summary dt { font-size: 13px; color: var(--muted); }
  .about-summary dd { margin: 2px 0 0; font-size: 15px; font-weight: 500; }
  .about-actions { margin-top: 28px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; }

  .about-pico { margin-top: 36px; }
  .pico-btn { padding: 0; border: 0; background: none; font: inherit; font-size: 15px; font-weight: 500; color: var(--ink); cursor: pointer; border-bottom: 1px dashed var(--accent); }
  .pico-peek { margin: 0; display: grid; grid-template-rows: 0fr; transition: grid-template-rows .6s var(--ease); }
  .about-pico:global(.open) .pico-peek { grid-template-rows: 1fr; }
  .pico-peek > div { overflow: hidden; display: flex; align-items: flex-end; gap: 14px; }
  .about-pico:not(:global(.open)) .pico-peek > div { visibility: hidden; }
  /* Pico rises from behind the rule, stopping short so he peeks rather than stands */
  .pico-window { flex: none; width: 120px; height: 104px; margin-top: 16px; overflow: hidden; border-bottom: 2px solid var(--ink); }
  .pico-window :global(img) { display: block; width: 120px; height: auto; transform: translateY(100%); transition: transform .8s cubic-bezier(.34, 1.4, .64, 1) .15s; }
  .about-pico:global(.open) .pico-window :global(img) { transform: translateY(6%); }
  .pico-note { padding-bottom: 8px; max-width: 18ch; font-family: 'Caveat', cursive; font-size: 22px; font-weight: 600; line-height: 1.1; color: var(--accent-ink); transform: rotate(-3deg); transform-origin: 0 100%; }
  .pico-note span span { opacity: 0; transition: opacity .12s linear; }
  .about-pico:global(.open) .pico-note span span { opacity: 1; transition-delay: calc(.75s + var(--i) * 35ms); }
  @media (prefers-reduced-motion: reduce) {
    .pico-peek, .pico-window :global(img), .pico-note span span { transition: none !important; }
  }

  .about-main { grid-column: 6 / span 7; }
  .about-main > section + section { margin-top: 52px; }
  .about-main h2, .about-body :global(h2) { font-size: clamp(26px, 2.6vw, 34px); }
  .about-body :global(h2:not(:first-child)) { margin-top: 52px; }
  .about-body :global(h2 + *) { margin-top: 20px; }
  .about-body :global(.anchor) { display: none; }
  .about-main h2 + .about-copy { margin-top: 20px; }
  .about-copy, .about-copy :global(p), .about-copy :global(li) { font-size: 17px; line-height: 1.6; color: var(--body); }
  .about-copy :global(p) { margin: 0 0 1em; }
  .about-copy > :global(:last-child) { margin-bottom: 0; }
  .about-copy :global(a) { color: var(--ink); text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 3px; }
  .about-body :global(blockquote) { margin: 36px 0; padding-left: 24px; border-left: 3px solid var(--accent); }
  .about-body :global(blockquote p) { margin: 0; font-family: var(--display); font-size: clamp(24px, 2.4vw, 32px); line-height: 1.2; letter-spacing: -.02em; color: var(--ink); }

  .about-copy .salt-intro { margin-bottom: 0; }
  .salt-link { padding: 0; border: 0; background: none; font: inherit; color: var(--ink); cursor: pointer; text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 3px; }
  .salt { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .6s var(--ease); }
  .salt:global(.open) { grid-template-rows: 1fr; }
  .salt > div { overflow: hidden; }
  .salt:not(:global(.open)) > div { visibility: hidden; }
  .salt-num { display: inline-flex; align-items: baseline; margin: 20px 0 0; padding: 0; border: 0; background: none; color: var(--ink); cursor: pointer; font-family: var(--display); font-size: clamp(56px, 6vw, 88px); font-weight: 600; letter-spacing: -.04em; line-height: 1; font-variant-numeric: tabular-nums; }
  .salt-num .c, .salt-num .p { display: inline-block; overflow: hidden; transition: max-width .7s var(--ease), opacity .5s var(--ease), transform .7s var(--ease); }
  .salt-num .c { max-width: .4em; }
  .salt-num .p { max-width: 0; opacity: 0; color: var(--accent); transform: translateY(-.4em); }
  .salt-num:global(.pi) .c { max-width: 0; opacity: 0; }
  .salt-num:global(.pi) .p { max-width: .4em; opacity: 1; transform: none; }
  .salt-cap { margin: 10px 0 0 !important; font-size: 15px !important; color: var(--muted) !important; }
  .salt-cap button { padding: 0; border: 0; background: none; font: inherit; color: var(--ink); cursor: pointer; border-bottom: 1px dashed var(--accent); }
  .salt-end { margin-top: 16px !important; opacity: 0; transition: opacity .5s var(--ease); }
  .salt-end:global(.show) { opacity: 1; }

  .socials { list-style: none; margin: 28px 0 0; padding: 0; display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; gap: 16px; }
  .socials li { display: block; margin: 0; padding: 0; }
  .socials a { display: inline-flex; align-items: center; justify-content: center; width: 60px; height: 60px; border: 1px solid var(--line); border-radius: 50%; color: var(--ink); transition: background-color .3s var(--ease), color .3s var(--ease), border-color .3s var(--ease), transform .35s var(--ease); }
  .socials a:hover { background: var(--ink); border-color: var(--ink); color: var(--bg); transform: translateY(-2px); }
  .about-fine { margin: 28px 0 0; font-size: 14px; color: var(--muted); }

  @media (max-width: 1100px) {
    .about-side, .about-main { grid-column: 1 / -1; }
    .about-side { position: static; margin-bottom: 64px; }
  }
  @media (max-width: 720px) {
    .about { padding-top: 40px; padding-bottom: 56px; }
    .about-main > section + section { margin-top: 48px; }
  }
</style>
