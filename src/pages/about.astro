---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { renderMarkdown } from '../lib/markdown-text';
import { withBase } from '../lib/url';

const about = await getEntry('pages', 'about');
if (!about) throw new Error('Missing src/content/pages/about.md');
const settings = await getEntry('settings', 'site');
if (!settings) throw new Error('Missing src/content/settings/site.json');
const { Content } = await render(about);
const { title, intro, lead, leadMore, welcomeImage, welcomeNote, summary, steps, signoff, quirks, now, contact } = about.data;
const github = settings.data.socials.find((s) => s.label === 'GitHub');

// Quirks are short markdown; site-root links ("/writing/...") get the base path like the rest of the site.
const quirkHtml = (q: string) => renderMarkdown(q).replaceAll('href="/', `href="${withBase('/')}`);

// Sections are numbered in page order, skipping any left empty in the CMS.
const sections = [
  steps.length > 0 && 'steps',
  'working',
  signoff && 'signoff',
  quirks.length > 0 && 'quirks',
  now.length > 0 && 'now',
  (contact || github) && 'contact',
].filter(Boolean) as string[];
const num = (id: string) => String(sections.indexOf(id) + 1).padStart(2, '0');

// Tiny icons for the step cards: the heap of pieces gets tidier from step to step.
const stepIcons = [
  '<rect x="6" y="14" width="18" height="12" rx="3" transform="rotate(-18 15 20)"/><rect x="18" y="8" width="14" height="14" rx="3" transform="rotate(14 25 15)"/><rect class="a" x="14" y="24" width="12" height="14" rx="3" transform="rotate(8 20 31)"/>',
  '<rect x="6" y="8" width="14" height="14" rx="3"/><rect x="24" y="8" width="14" height="14" rx="3"/><rect x="6" y="26" width="14" height="14" rx="3"/><rect class="a" x="24" y="26" width="14" height="14" rx="3"/>',
  '<rect x="6" y="8" width="32" height="12" rx="3"/><rect class="a" x="6" y="24" width="14" height="16" rx="3"/><rect x="24" y="24" width="14" height="16" rx="3"/>',
  '<rect class="k" x="6" y="8" width="32" height="32" rx="9"/><path class="tick" d="M14 24l5 5 11-12"/>',
];
---
<BaseLayout title="About" description={intro}>
  <div class="about wrap">
    <header class="about-head">
      <div>
        <h1>{title}</h1>
        {lead && <p class="about-lead">{lead}{leadMore && <> <span>{leadMore}</span></>}</p>}
        {github && <p class="about-meta"><a href={github.url} rel="me noopener">{github.meta ?? github.url} <span aria-hidden="true">↗</span></a></p>}
      </div>
      {welcomeImage && (
        <figure class="about-pico" data-reveal-note>
          {welcomeNote && <figcaption class="about-pico-note">{welcomeNote}</figcaption>}
          <Image src={welcomeImage} alt="Pico the penguin waving hello from behind a laptop, next to a mug and a stack of books" widths={[360, 720]} sizes="(max-width: 720px) 220px, 360px" loading="eager" />
        </figure>
      )}
    </header>

    {summary.length > 0 && (
      <dl class="about-summary">
        {summary.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
      </dl>
    )}

    {steps.length > 0 && (
      <section class="about-sec wide" id="approach">
        <h2 class="about-label"><span>{num('steps')}</span>How I take a problem apart</h2>
        <ol class="about-steps">
          {steps.map((step, i) => (
            <li>
              <svg viewBox="0 0 44 48" aria-hidden="true" set:html={stepIcons[i % stepIcons.length]} />
              <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    <section class="about-sec" id="working-on">
      <h2 class="about-label"><span>{num('working')}</span>What I’m working on now</h2>
      <div class="about-body"><Content /></div>
    </section>

    {signoff && (
      <section class="about-sec">
        <h2 class="about-label"><span>{num('signoff')}</span>What I won’t sign off on</h2>
        <div class="about-body"><p>{signoff}</p></div>
      </section>
    )}

    {quirks.length > 0 && (
      <section class="about-sec">
        <h2 class="about-label"><span>{num('quirks')}</span>Known quirks</h2>
        <div class="about-body">
          <ul class="about-quirks">{quirks.map((q) => <li set:html={quirkHtml(q)} />)}</ul>
        </div>
      </section>
    )}

    {now.length > 0 && (
      <section class="about-sec">
        <h2 class="about-label"><span>{num('now')}</span>Right now</h2>
        <div class="about-body">
          <dl class="about-now">{now.map((n) => <><dt>{n.label}</dt><dd>{n.value}</dd></>)}</dl>
        </div>
      </section>
    )}

    {(contact || github) && (
      <section class="about-sec">
        <h2 class="about-label"><span>{num('contact')}</span>Get in touch</h2>
        <div class="about-body">
          <p>{contact}{github && <> <a class="home-link accent" href={github.url} rel="me noopener">GitHub <span aria-hidden="true">↗</span></a></>}</p>
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<script>
  import { initRevealNotes } from '../scripts/reveal-note';
  initRevealNotes();
</script>
