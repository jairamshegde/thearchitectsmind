---
import { getEntry, render } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';

const about = await getEntry('pages', 'about');
if (!about) throw new Error('Missing src/content/pages/about.md');
const { Content, headings } = await render(about);
---
<ArticleLayout title="About" description={about.data.intro} headings={headings}>
  <Fragment slot="header">
    <p class="article-kicker">About</p>
    <h1 class="article-title">{about.data.title}</h1>
  </Fragment>
  <Content />
</ArticleLayout>
