---
import '../styles/prose.css';
import BaseLayout from './BaseLayout.astro';
import Toc from '../components/Toc.astro';
import type { Heading } from '../lib/toc';

interface Props {
  title: string;
  description?: string;
  headings: Heading[];
  /** Index page this article belongs to, linked at the top. */
  back?: { href: string; label: string };
}
const { title, description, headings, back } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <div class="article-shell wrap">
    <Toc headings={headings} variant="rail" />
    <article class="article">
      <header class="article-head">
        {back && <a class="article-crumb" href={back.href}><span class="arr" aria-hidden="true">←</span> {back.label}</a>}
        <slot name="header" />
      </header>
      <Toc headings={headings} variant="inline" />
      <div class="prose"><slot /></div>
      <slot name="after" />
    </article>
  </div>
</BaseLayout>

<script>
  import { initTocRail } from '../scripts/toc-rail';
  import { initCopyButtons } from '../scripts/copy-code';
  import { initMermaid } from '../scripts/mermaid';
  import { initRevealNotes } from '../scripts/reveal-note';
  initTocRail();
  initCopyButtons();
  initMermaid();
  initRevealNotes();
</script>
