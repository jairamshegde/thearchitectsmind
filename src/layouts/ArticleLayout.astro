---
// BaseLayout first, so its shared sheets come before the article sheets in the bundle.
import BaseLayout from './BaseLayout.astro';
import '../styles/prose.css';
import '../styles/post.css';
import Toc from '../components/Toc.astro';
import type { Heading } from '../lib/toc';

interface Props {
  title: string;
  description?: string;
  headings: Heading[];
  /** Index page this article belongs to, linked at the top. */
  back?: { href: string; label: string };
  /** Extra class on the header, e.g. "post-head" for blog posts. */
  headClass?: string;
  /** Shown as a "Tagged" row after the article text. */
  tags?: string[];
}
const { title, description, headings, back, headClass, tags = [] } = Astro.props;
---
<BaseLayout title={title} description={description} variant="post">
  <div class="progress" aria-hidden="true"><i data-progress></i></div>
  <article class="post-page wrap" data-article>
    <header class:list={['article-head', headClass]}>
      {back && <a class="back-link" href={back.href}>{back.label}</a>}
      <slot name="header" />
    </header>
    <div class="article-shell">
      <Toc headings={headings} />
      <div class="article">
        <div class="prose"><slot /></div>
        {tags.length > 0 && (
          <div class="post-tags">
            <span class="post-tags-label">Tagged</span>
            <ul class="tags">{tags.map((tag) => <li class="tag">{tag}</li>)}</ul>
          </div>
        )}
        <slot name="after" />
        <span data-article-end></span>
      </div>
    </div>
    <slot name="end" />
  </article>
</BaseLayout>

<script>
  import { initTocRail } from '../scripts/toc-rail';
  import { initCopyButtons } from '../scripts/copy-code';
  import { initMermaid } from '../scripts/mermaid';
  import { initProgress } from '../scripts/progress';
  initTocRail();
  initCopyButtons();
  initMermaid();
  initProgress();
</script>
