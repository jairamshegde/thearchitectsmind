---
import { getEntry } from 'astro:content';
import { SITE } from '../site.config';

const settings = await getEntry('settings', 'site');
if (!settings) throw new Error('Missing src/content/settings/site.json');
const { footerStatement, footerTopics, footerSub, email, socials } = settings.data;
const mailto = `mailto:${email ?? '[YOUR EMAIL]'}`;
---
<footer id="contact" class="band">
  <div class="wrap">
    <p class="band-big"><span class="band-lead">{footerStatement}</span> <span class="band-end"><span class="band-word" data-footer-word data-topics={footerTopics.join('|')}>anything</span><i>.</i></span></p>
    <div class="band-row">
      <p class="band-sub">{footerSub}</p>
      <div class="band-act">
        <a class="pill pill-accent cta" href={mailto}>Say hello</a>
        {socials.map((s) => <a class="ul" href={s.url} rel="me noopener">{s.label}</a>)}
      </div>
    </div>
    <div class="band-foot">
      <span>© {new Date().getFullYear()} {SITE.author}.</span>
      <a class="ul" href="#top">Back to top</a>
    </div>
  </div>
</footer>

<script>
  import { initFooterWord } from '../scripts/footer-word';
  initFooterWord();
</script>

<style>
  .band { background: var(--band-bg); color: var(--band-ink); }
  .band .wrap { padding-top: 64px; padding-bottom: calc(32px + env(safe-area-inset-bottom, 0px)); }
  .band-big { margin: 0; font-family: var(--display); font-weight: 600; font-size: clamp(34px, 4.4vw, 60px); line-height: 1.05; letter-spacing: -.035em; }
  .band-lead { color: var(--band-muted); }
  .band-end { white-space: nowrap; }
  .band-word { display: inline-block; transition: opacity .3s var(--ease), transform .3s var(--ease); }
  .band-word.out { opacity: 0; transform: translateY(.18em); }
  .band-big i { font-style: normal; color: var(--accent); }
  .band-row { margin-top: 28px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 40px; }
  .band-sub { margin: 0; max-width: 52ch; font-size: 17px; line-height: 1.5; color: var(--band-muted); }
  .band-act { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; font-size: 16px; font-weight: 500; }
  .band-foot { margin-top: 48px; padding-top: 20px; border-top: 1px solid var(--band-line); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 24px; font-size: 14px; color: var(--band-muted); }
  .band-foot a { color: var(--band-ink); }

  /* the word gets its own line on phones, so the heading keeps one height for every topic */
  @media (max-width: 720px) {
    .band-end { display: block; }
  }
</style>
