---
import { pixelCells, type FieldConfig } from '../lib/pixel-field';

interface Props {
  config: FieldConfig;
  class?: string;
}
const { config: c, class: cls } = Astro.props;
const pitch = c.cell + c.gap;
const cells = pixelCells(c);
---
<div
  class:list={['pf', cls]}
  role="img"
  aria-label="Pixel art: scattered noise around a small spark with an empty centre"
  data-pf
  data-cols={c.cols}
  data-rows={c.rows}
  data-cx={c.cx}
  data-cy={c.cy}
  data-pitch={pitch}
  data-cell={c.cell}
  style={`--cols:${c.cols};--rows:${c.rows};--cell:${c.cell}px;--gap:${c.gap}px`}
>
  {cells.map((p) => (
    <i
      class:list={[p.kind === 'spark' ? 'pf-s' : 'pf-n', { tw: p.twinkle }]}
      style={`grid-area:${p.row + 1}/${p.col + 1};--o:${p.opacity};--d:${p.delay}s;--dl:${(Math.hypot(p.col - c.cx, p.row - c.cy) * 0.03).toFixed(2)}s`}
    ></i>
  ))}
</div>

<style is:global>
  /* --k dims the whole field (the hero lights it up); registered so it can transition */
  @property --k { syntax: '<number>'; inherits: true; initial-value: 1; }
</style>

<style>
  .pf {
    position: relative; cursor: crosshair; flex: none;
    display: grid;
    grid-template-columns: repeat(var(--cols), var(--cell));
    grid-template-rows: repeat(var(--rows), var(--cell));
    gap: var(--gap);
  }
  .pf i { border-radius: 2px; opacity: 0; animation: pxIn .7s var(--ease) var(--d) forwards; }
  .pf .pf-n { background: var(--px); }
  .pf .pf-s { background: var(--px-spark); }
  .pf i.tw { animation: pxIn .7s var(--ease) var(--d) forwards, tw 3.2s ease-in-out calc(var(--d) + .7s) infinite; }
  @keyframes pxIn { from { opacity: 0; transform: scale(.4); } to { opacity: calc(var(--o) * var(--k)); transform: none; } }
  @keyframes tw { 0%, 100% { opacity: calc(var(--o) * var(--k)); } 50% { opacity: .08; } }
  @media (prefers-reduced-motion: reduce) {
    .pf i { opacity: calc(var(--o) * var(--k)); }
  }
</style>
