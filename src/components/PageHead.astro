---
interface Props {
  /** First title line, set in grey. */
  lead: string;
  /** Second title line; an orange period is added after it. */
  title: string;
  intro?: string;
}
const { lead, title, intro } = Astro.props;
---
<header class="wrap page-head-x">
  <h1 class="page-title">
    <span class="mask"><span class="lead">{lead}</span></span>{' '}
    <span class="mask"><span style="--d:.12s">{title}<span class="accent-dot">.</span></span></span>
  </h1>
  {intro && <p class="page-intro fade-up" style="--d:.45s">{intro}</p>}
  <slot />
</header>

<style>
  .page-head-x { padding-top: 64px; padding-bottom: 56px; }
  .page-title { font-size: clamp(48px, 7vw, 96px); line-height: .95; letter-spacing: -.045em; }
  .lead { color: var(--title-muted); }
  .accent-dot { color: var(--accent); }
  .page-intro { margin: 28px 0 0; max-width: 560px; font-size: 18px; line-height: 1.5; color: var(--muted); }
  @media (max-width: 720px) {
    .page-head-x { padding-top: 40px; padding-bottom: 40px; }
  }
</style>
