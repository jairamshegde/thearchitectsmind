---
import { formatDate } from '../lib/format';

export type BandPost = { href: string; date: Date; title: string; minutes: number };
export type BandNote = { href: string; topic: string; date: Date; title: string };

interface Props {
  posts: BandPost[];
  notes: BandNote[];
  blogHref?: string;
  notesHref?: string;
}
const { posts, notes, blogHref = '/writing/', notesHref = '/notes/' } = Astro.props;
---
<section id="writing" class="wband" data-tabs data-blog-href={blogHref} data-notes-href={notesHref}>
  <div class="wrap">
    <h2 class="visually-hidden">Blog and notes</h2>
    <div class="sec-top">
      <div class="tablist" role="tablist" aria-label="Blog or notes">
        <button type="button" role="tab" id="tab-blog" aria-selected="true" aria-controls="panel-blog" tabindex="0" data-tab="blog">Blog</button>
        <button type="button" role="tab" id="tab-notes" aria-selected="false" aria-controls="panel-notes" tabindex="-1" data-tab="notes">Notes</button>
      </div>
      <a class="ul" href={blogHref} data-all>All posts</a>
    </div>

    <div class="panel grid" role="tabpanel" id="panel-blog" aria-labelledby="tab-blog">
      <p class="panel-desc">Long-form essays from building Mingraph. Each one takes a single design pattern and builds it into a working LLM framework.</p>
      {posts.length > 0 ? (
        <ul class="rows">
          {posts.map((p) => (
            <li>
              <a class="row" href={p.href}>
                <time class="row-date" datetime={p.date.toISOString().slice(0, 10)}>{formatDate(p.date)}</time>
                <span class="row-title">{p.title}</span>
                <span class="row-time"><span class="go">Read</span>{p.minutes} min</span>
              </a>
            </li>
          ))}
        </ul>
      ) : <p class="panel-list empty">First post coming soon.</p>}
    </div>

    <div class="panel grid" role="tabpanel" id="panel-notes" aria-labelledby="tab-notes" hidden>
      <p class="panel-desc">Short, unpolished notes. Sketches, half-formed ideas and things I’m still figuring out.</p>
      {notes.length > 0 ? (
        <ul class="cards">
          {notes.map((n) => (
            <li>
              <a class="note-card" href={n.href}>
                <span class="card-meta"><span class="card-topic">{n.topic}</span><time datetime={n.date.toISOString().slice(0, 10)}>{formatDate(n.date)}</time></span>
                <span class="card-title">{n.title}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : <p class="panel-list empty">No notes yet.</p>}
    </div>
  </div>
</section>

<style>
  .wband { background: var(--band-soft); border-top: 1px solid var(--line); }
  .wband > .wrap { padding-top: 88px; padding-bottom: 96px; }
  .tablist { display: flex; align-items: end; gap: 40px; }
  [role='tab'] {
    appearance: none; border: 0; background: none; margin: 0; padding: 0 0 6px; cursor: pointer;
    color: var(--tab-off); line-height: 1;
    font-family: var(--display); font-weight: 600; font-size: clamp(30px, 3.2vw, 40px); letter-spacing: -.03em;
    background-image: linear-gradient(var(--accent), var(--accent)); background-repeat: no-repeat; background-position: 0 100%; background-size: 0% 3px;
    transition: color .4s var(--ease), background-size .5s var(--ease);
  }
  [role='tab']:hover, [role='tab'][aria-selected='true'] { color: var(--ink); }
  [role='tab'][aria-selected='true'] { background-size: 100% 3px; }
  .sec-top { padding-bottom: 22px; }

  .panel { margin-top: 48px; }
  .panel[hidden] { display: none; }
  .panel:not([hidden]) > * { animation: swap .55s var(--ease); }
  @keyframes swap { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  .panel-desc { grid-column: 1 / span 4; margin: 0; max-width: 340px; font-size: 18px; line-height: 1.5; color: var(--muted); }
  .rows, .cards, .panel-list { grid-column: 6 / span 7; }
  .rows { list-style: none; margin: 0; padding: 0; }
  .row { position: relative; display: grid; grid-template-columns: 112px minmax(0, 1fr) 80px; gap: 20px; align-items: baseline; padding: 24px 0; border-bottom: 1px solid var(--line); }
  .row::before, .note-card::before { content: ''; position: absolute; inset: 0 -20px; z-index: 0; border-radius: 10px; background: var(--soft); opacity: 0; transform: scaleY(.85); transition: opacity .35s var(--ease), transform .45s var(--ease); }
  .note-card::before { inset: 0; border-radius: 14px; }
  .row > *, .note-card > * { position: relative; z-index: 1; }
  .row:hover::before, .note-card:hover::before { opacity: 1; transform: none; }
  .row-date, .row-time, .card-meta { font-size: 12px; font-weight: 500; color: var(--muted); }
  .row-title { font-size: 22px; font-weight: 500; line-height: 1.3; letter-spacing: -.012em; transition: transform .45s var(--ease); }
  .row:hover .row-title { transform: translateX(6px); }
  .row-time { text-align: right; white-space: nowrap; }
  .go { display: inline-block; margin-right: 6px; color: var(--ink); opacity: 0; transform: translateX(-6px); transition: opacity .3s var(--ease), transform .45s var(--ease); }
  .row:hover .go { opacity: 1; transform: none; }

  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .note-card { position: relative; display: flex; flex-direction: column; justify-content: space-between; gap: 32px; height: 100%; min-height: 168px; padding: 24px; border: 1px solid var(--line); border-radius: 14px; }
  .card-meta { display: flex; justify-content: space-between; gap: 12px; }
  .card-title { font-size: 20px; font-weight: 500; line-height: 1.3; letter-spacing: -.01em; }
  .panel-list.empty { margin: 0; }

  /* side by side: lift the list so the first title lines up with the description */
  @media (min-width: 1101px) { .rows { margin-top: -24px; } }
  @media (max-width: 1100px) {
    .panel-desc { grid-column: 1 / -1; max-width: 520px; margin-bottom: 32px; }
    .rows, .cards, .panel-list { grid-column: 1 / -1; }
  }
  @media (max-width: 720px) {
    .wband > .wrap { padding-top: 64px; padding-bottom: 72px; }
    .tablist { gap: 28px; }
    .panel { margin-top: 32px; }
    .row { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'label time' 'title title'; gap: 8px 16px; padding: 20px 0; }
    .row::before { inset: 0 -10px; }
    .row-date { grid-area: label; }
    .row-time { grid-area: time; }
    .row-title { grid-area: title; font-size: 20px; }
    .cards { grid-template-columns: minmax(0, 1fr); }
    .note-card { min-height: 140px; }
  }
</style>

<script>
  import { initTabs } from '../scripts/tabs';
  initTabs();
</script>
