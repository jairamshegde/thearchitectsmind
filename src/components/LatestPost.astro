---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import PostMeta from './PostMeta.astro';
import { withBase } from '../lib/url';

interface Props {
  post: CollectionEntry<'writing'>;
}
const { post } = Astro.props;
const { title, description, date, tags, cover } = post.data;
const { remarkPluginFrontmatter } = await render(post);
---
<a class="latest" href={withBase(`/writing/${post.id}/`)}>
  <span class="thumb">
    {cover ? (
      <Image src={cover} alt="" widths={[600, 1200]} sizes="(max-width: 900px) 100vw, 560px" />
    ) : (
      <span class="thumb-fallback"><span class="hand">{tags[0]}</span></span>
    )}
  </span>
  <span class="body">
    <span class="kicker">Latest post</span>
    <h2>{title}</h2>
    <p>{description}</p>
    <PostMeta date={date} minutes={remarkPluginFrontmatter.minutesRead} />
  </span>
</a>
