<button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme" aria-pressed="false">
  <span class="ts-track" aria-hidden="true">
    <span class="ts-thumb"></span>
    <svg class="ts-icon ts-sun" viewBox="0 0 24 24" width="14" height="14"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4" /></svg>
    <svg class="ts-icon ts-moon" viewBox="0 0 24 24" width="14" height="14"><path d="M20.5 13.2A8.5 8.5 0 1 1 10.8 3.5a6.6 6.6 0 0 0 9.7 9.7z" /></svg>
  </span>
</button>

<style>
  .theme-toggle { --ts-move: 28px; appearance: none; flex: none; display: inline-flex; align-items: center; min-height: 44px; padding: 0; border: 0; background: none; cursor: pointer; }
  .ts-track { position: relative; display: inline-flex; align-items: center; justify-content: space-between; width: 60px; height: 32px; padding: 0 8px; border: 1px solid var(--line); border-radius: 999px; transition: border-color .3s var(--ease); }
  .theme-toggle:hover .ts-track { border-color: var(--ink); }
  .ts-thumb { position: absolute; top: 3px; left: 3px; width: 24px; height: 24px; border-radius: 50%; background: var(--ink); transition: transform .45s var(--ease); }
  .ts-icon { position: relative; fill: none; stroke: var(--muted); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; transition: stroke .3s var(--ease); }
  /* light: thumb over the sun; dark: thumb over the moon */
  .ts-sun { stroke: var(--bg); }
  :root[data-theme='dark'] .ts-thumb { transform: translateX(var(--ts-move)); }
  :root[data-theme='dark'] .ts-sun { stroke: var(--muted); }
  :root[data-theme='dark'] .ts-moon { stroke: var(--bg); }
  @media (max-width: 360px) {
    .theme-toggle { --ts-move: 20px; }
    .ts-track { width: 52px; padding: 0 6px; }
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .ts-thumb { transform: translateX(var(--ts-move)); }
    :root:not([data-theme='light']) .ts-sun { stroke: var(--muted); }
    :root:not([data-theme='light']) .ts-moon { stroke: var(--bg); }
  }
</style>

<script>
  import { initThemeToggle } from '../scripts/theme';
  initThemeToggle();
</script>
