---
import { shouldShowToc, tocItems, type Heading } from '../lib/toc';

interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
const items = tocItems(headings);
---
{shouldShowToc(headings) && (
  <nav class="toc" aria-label="On this page" data-toc>
    <p class="toc-label">On this page</p>
    <ol>
      {items.map((h) => <li><a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a></li>)}
    </ol>
  </nav>
)}
