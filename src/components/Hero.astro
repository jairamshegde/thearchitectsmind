---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { published } from '../lib/collections';
import { pickHome } from '../lib/content';
import { withBase } from '../lib/url';

const settings = await getEntry('settings', 'site');
if (!settings) throw new Error('Missing src/content/settings/site.json');
const { heroLead, heroHeadline, heroSub, heroImage } = settings.data;

// The first link points at the featured project, named by the part of its title before any colon.
const [project] = pickHome(await published('projects'), 1);
const ctas: [string, string][] = [
  project ? [`See ${project.data.title.split(':')[0]}`, `/projects/${project.id}/`] : ['See the projects', '/projects/'],
  ['Read the writing', '/writing/'],
];

const underline = 'M3 8 C 50 3, 110 11, 197 5';
---
<section class="hero wrap">
  <h1 class="hl">
    <span class="hl-lead">{heroLead}</span>
    <span class="hl-main">{heroHeadline}<svg class="hl-ul" viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true"><path d={underline} /></svg></span>
  </h1>
  <p class="hero-sub">{heroSub}</p>
  <div class="ctas">
    {ctas.map(([label, href]) => (
      <a class="hero-link" href={withBase(href)}>{label} <span class="arr" aria-hidden="true">→</span></a>
    ))}
  </div>

  {heroImage && (
    <figure class="hero-art">
      <Image src={heroImage} alt="A heap of docs, links, videos, PDFs, code and notes turned into an AI agent with search, generation and tool steps, checked by traces and evals, while Pico sketches the plan" widths={[720, 1104, 1600, 1806]} sizes="(max-width: 1200px) 100vw, 1104px" loading="eager" />
    </figure>
  )}
</section>
