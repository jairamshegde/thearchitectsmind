---
import { getEntry } from 'astro:content';
import PixelField from './PixelField.astro';
import { HOME_FIELD } from '../lib/pixel-field';
import { SITE } from '../site.config';

const settings = await getEntry('settings', 'site');
if (!settings) throw new Error('Missing src/content/settings/site.json');
const { heroLead, heroHeadline, heroSub, heroBio, socials } = settings.data;
const github = socials.find((s) => s.label === 'GitHub')?.url ?? `https://github.com/${SITE.owner}`;
// The CMS text is the word; the orange period belongs to the design.
const headline = heroHeadline.replace(/\.$/, '');
---
<section id="hero" class="wrap grid hero">
  <div class="hero-text">
    <h1>
      <span class="mask"><span class="lead" style="--d:.08s">{heroLead}</span></span>{' '}
      <span class="mask"><span style="--d:.2s">{headline}<span class="accent-dot">.</span></span></span>
    </h1>
    <div class="fade-up" style="--d:.55s">
      <p class="hero-sub">{heroSub}</p>
      {heroBio && <p class="hero-bio">{heroBio}</p>}
    </div>
    <div class="hero-links fade-up" style="--d:.7s">
      <a class="ul-on" href="#projects">See the projects</a>
      <a class="ul-on" href="#writing" data-tab-link="blog">Read the blog</a>
      <a class="ul-on" href={github} rel="me noopener">GitHub</a>
    </div>
  </div>
  <PixelField config={HOME_FIELD} class="hero-field" />
</section>

<style>
  .hero { padding-top: 72px; padding-bottom: 128px; align-items: center; }
  .hero-text { grid-column: 1 / span 7; min-width: 0; }
  h1 { font-size: clamp(56px, 8vw, 112px); line-height: .95; letter-spacing: -.045em; white-space: nowrap; }
  .lead { color: var(--title-muted); }
  .accent-dot { color: var(--accent); }
  .hero-sub { margin: 40px 0 0; font-family: var(--display); font-size: clamp(24px, 2.4vw, 32px); font-weight: 500; line-height: 1.15; letter-spacing: -.02em; }
  .hero-bio { margin: 18px 0 0; max-width: 520px; font-size: 18px; line-height: 1.5; color: var(--muted); }
  .hero-links { margin-top: 36px; display: flex; flex-wrap: wrap; gap: 12px 28px; font-size: 16px; font-weight: 500; }
  .hero :global(.hero-field) { grid-column: 8 / span 5; justify-self: end; }

  @media (max-width: 1100px) {
    .hero { padding-bottom: 96px; }
    .hero-text { grid-column: 1 / -1; }
    /* under the text, scaled down; the transform keeps the grid maths intact for the pointer */
    .hero :global(.hero-field) { grid-column: 1 / -1; justify-self: start; margin-top: 56px; transform: scale(.8); transform-origin: 0 0; margin-bottom: -88px; }
  }
  @media (max-width: 720px) {
    .hero { padding-top: 48px; padding-bottom: 72px; }
    h1 { font-size: clamp(44px, 13.5vw, 56px); }
    .hero-sub { margin-top: 28px; }
    .hero :global(.hero-field) { display: none; }
  }
</style>
