---
import { getEntry } from 'astro:content';
import PixelField from './PixelField.astro';
import { HOME_FIELD } from '../lib/pixel-field';
import { withBase } from '../lib/url';

const settings = await getEntry('settings', 'site');
if (!settings) throw new Error('Missing src/content/settings/site.json');
const { heroLead, heroHeadline, heroSub, heroBio } = settings.data;
// The CMS text is the word; the orange period belongs to the design.
const headline = heroHeadline.replace(/\.$/, '');
---
<section id="hero" class="wrap grid hero" data-hero>
  <div class="hero-text">
    <h1>
      <span class="mask"><span class="lead" style="--d:.08s">{heroLead}</span></span>{' '}
      <span class="mask"><span class="word" style="--d:.2s">{headline}<span class="accent-dot" data-hero-dot>.</span></span></span>
    </h1>
    <div class="fade-up" style="--d:.55s">
      <p class="hero-sub">{heroSub}</p>
      {heroBio && <p class="hero-bio">{heroBio}</p>}
    </div>
    <div class="hero-actions fade-up" style="--d:.7s">
      <a class="pill pill-accent" href={withBase('/writing/')}>Read the Writing</a>
      <span class="hero-more">
        <a class="ul" href={withBase('/projects/')}>Projects</a>
        <span aria-hidden="true">·</span>
        <a class="ul" href={withBase('/about/')}>About</a>
      </span>
    </div>
  </div>
  <PixelField config={HOME_FIELD} class="hero-field" />
  <span class="hero-sq" aria-hidden="true" data-hero-sq></span>
</section>

<script>
  import { initHeroDot } from '../scripts/hero-dot';
  initHeroDot();
</script>

<style>
  .hero { padding-top: 40px; padding-bottom: 56px; align-items: center; }
  .hero-text { grid-column: 1 / span 7; min-width: 0; }
  h1 { line-height: .95; letter-spacing: -.045em; white-space: nowrap; }
  .lead { padding-bottom: .2em; font-size: clamp(24px, 2.6vw, 36px); font-weight: 500; letter-spacing: -.02em; color: var(--title-muted); }
  .word { font-size: clamp(64px, 8vw, 112px); transition: color .5s var(--ease); }
  /* the word takes the full stop's colour while the stop sits in the spark */
  .hero.armed.lit .word { color: var(--accent); }
  /* the full stop is drawn as a circle so the square can take its exact place; the "." stays in the text */
  .accent-dot { display: inline-block; width: .17em; height: .17em; margin-left: .03em; overflow: hidden; border-radius: 50%; background: var(--accent); color: transparent; line-height: 0; vertical-align: baseline; }
  .hero { position: relative; }
  .hero.away .accent-dot { visibility: hidden; }
  .hero-sq { position: absolute; z-index: 2; left: 0; top: 0; width: 0; height: 0; background: var(--accent); pointer-events: none; opacity: 0; will-change: transform;
    transition: transform var(--t, .6s) var(--ease), width .5s var(--ease), height .5s var(--ease), border-radius .5s var(--ease); }
  .hero.away .hero-sq { opacity: 1; }
  /* dim until the full stop arrives; lights up outward from the centre */
  .hero.armed :global(.pf i) { --k: .4; transition: --k .5s var(--ease) calc(var(--dl) * .3); }
  .hero.armed.lit :global(.pf i) { --k: 1; transition: --k .55s var(--ease) var(--dl); }
  .hero :global(.pf-ghost) { border-radius: 2px; background: var(--accent); pointer-events: none; animation: ghost 1.1s var(--ease) forwards; }
  @keyframes ghost { from { opacity: .7; transform: scale(1); } to { opacity: 0; transform: scale(.6); } }
  .hero-sub { margin: 28px 0 0; max-width: 600px; font-family: var(--display); font-size: clamp(20px, 1.8vw, 24px); font-weight: 600; line-height: 1.3; letter-spacing: -.015em; }
  .hero-bio { margin: 18px 0 0; max-width: 520px; font-size: 18px; line-height: 1.5; color: var(--muted); }
  .hero-actions { margin-top: 32px; display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; }
  .hero-more { display: flex; gap: 10px; font-size: 16px; font-weight: 500; color: var(--muted); }
  .hero-more a { color: var(--ink); }
  .hero :global(.hero-field) { grid-column: 8 / span 5; justify-self: end; }

  @media (max-width: 1100px) {
    .hero { padding-bottom: 56px; }
    .hero-text { grid-column: 1 / -1; }
    /* under the text, scaled down; the transform keeps the grid maths intact for the pointer */
    .hero :global(.hero-field) { grid-column: 1 / -1; justify-self: start; margin-top: 56px; transform: scale(.8); transform-origin: 0 0; margin-bottom: -88px; }
  }
  @media (max-width: 720px) {
    .hero { padding-top: 32px; padding-bottom: 48px; }
    h1 { white-space: normal; overflow-wrap: anywhere; }
    .word { font-size: clamp(56px, 17vw, 72px); }
    .hero-sub { margin-top: 20px; }
    .hero :global(.hero-field) { display: none; }
  }
</style>
