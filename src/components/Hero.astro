---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { withBase } from '../lib/url';

const settings = await getEntry('settings', 'site');
if (!settings) throw new Error('Missing src/content/settings/site.json');
const { heroKicker, heroHeadline, heroSub, heroNote, heroImage } = settings.data;
// One line per sentence: "I make computers do interesting things." / "Then I get suspicious."
const headlineLines = heroHeadline.split(/(?<=[.!?])\s+/);
const scribble = 'M2 6 C 30 2, 60 9, 90 5 S 135 3, 148 6';
---
<section class="hero wrap">
  <div class="hero-text">
    {heroKicker && <p class="hero-kicker">{heroKicker}</p>}
    <h1 class="hl">{headlineLines.map((line, i) => <>{i > 0 && ' '}<span class="hl-line">{line}</span></>)}</h1>
    <p class="hero-sub">{heroSub}</p>
    <div class="ctas">
      {[['View projects', '/projects/'], ['Read the writing', '/writing/']].map(([label, href]) => (
        <a class="btn btn-text" href={withBase(href)}>
          {label} <span class="arr" aria-hidden="true">→</span>
          <svg class="scribble" viewBox="0 0 150 10" preserveAspectRatio="none" aria-hidden="true"><path d={scribble} /></svg>
        </a>
      ))}
    </div>
  </div>
  {heroImage && (
    <figure class="about-pico hero-pico" data-reveal-note>
      <figcaption class="about-pico-note">{heroNote}</figcaption>
      <Image src={heroImage} alt="Pico the penguin, squinting suspiciously at a sheet of paper" widths={[220, 440]} sizes="220px" loading="eager" />
    </figure>
  )}
</section>
