---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { isCaseStudy } from '../lib/content';
import { renderMarkdown } from '../lib/markdown-text';

interface Props {
  project: CollectionEntry<'projects'>;
}
const d = Astro.props.project.data;
const full = isCaseStudy(d);
const problem = d.problem?.trim();
const hasLinks = Boolean(d.links?.repo || d.links?.demo);
---
{d.cover && <figure class="post-cover cs-cover"><Image src={d.cover} alt="" widths={[760, 1140, 1520]} sizes="(max-width: 1100px) calc(100vw - 80px), 760px" loading="eager" /></figure>}
<p class="article-kicker">{full ? 'Case study' : 'Project'}</p>
<h1 class="article-title">{d.title}</h1>

{(problem || hasLinks) && (
  <dl class="cs-table">
    {problem && <div><dt>Problem</dt><dd set:html={renderMarkdown(problem)} /></div>}
    {hasLinks && (
      <div>
        <dt>Links</dt>
        <dd class="cs-links">
          {d.links?.repo && <a href={d.links.repo} rel="noopener">Repository</a>}
          {d.links?.demo && <a href={d.links.demo} rel="noopener">Live demo</a>}
        </dd>
      </div>
    )}
  </dl>
)}
